# ============================================================
# Copia este archivo a .env y rellena con tus valores reales.
# .env está en .gitignore — nunca se sube al repo.
# ============================================================

# ---- FRONTEND (también en config.js para el navegador) ----
SUPABASE_URL=YOUR_SUPABASE_URL
SUPABASE_KEY=YOUR_SUPABASE_ANON_KEY

# ---- BACKEND (FastAPI / rag_service.py) ----
# Service Role Key: Supabase > Project Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# OpenAI — necesaria para el motor RAG (LangChain)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
